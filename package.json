    "@types/react": "^19.2.17",
    "@types/react-dom": "^19.2.3",
    "appwrite": "^26.2.0",
    "astro": "^7.1.3",
    "class-variance-authority": "^0.7.1",
    "clsx": "^2.1.1",
    "es-toolkit": "^1.50.0",
    "lucide-react": "^1.27.0",
    "next-themes": "^0.4.6",
    "node-appwrite": "^27.1.0",
    "radix-ui": "^1.6.7",
    "react": "^19.2.8",
    "react-dom": "^19.2.8",
