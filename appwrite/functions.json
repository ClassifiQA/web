[
  {
    "$id": "sync-members",
    "name": "sync-members",
    "enabled": true,
    "logging": true,
    "runtime": "bun-1.3",
    "buildSpecification": "s-8vcpu-8gb",
    "runtimeSpecification": "s-8vcpu-8gb",
    "deploymentRetention": 7,
    "scopes": ["rows.read", "rows.write"],
    "events": [],
    "schedule": "0 3 * * *",
    "timeout": 300,
    "entrypoint": "src/main.js",
    "commands": "bun install --frozen-lockfile",
    "ignore": "node_modules\n.env\ncoverage",
    "path": "../functions/sync-members"
  }
]
