---
type Props = {
  title: string
  description: string
  updatedAt: string
}

const { title, description, updatedAt } = Astro.props
---

<div class="min-h-0 flex-1 overflow-y-auto">
  <article
    class="legal-copy mx-auto w-full max-w-4xl px-5 py-8 sm:px-8 sm:py-12">
    <header class="border-b border-border pb-7">
      <p class="text-xs font-bold tracking-[0.16em] text-accent uppercase">
        Informação legal
      </p>
      <h1 class="mt-2 text-3xl font-bold tracking-tight sm:text-4xl">
        {title}
      </h1>
      <p class="mt-3 max-w-3xl text-base leading-7 text-muted-foreground">
        {description}
      </p>
      <p class="mt-4 text-sm text-muted-foreground">
        Última atualização: <time>{updatedAt}</time>
      </p>
    </header>

    <slot />
  </article>
</div>

<style is:global>
  .legal-copy {
    line-height: 1.7;
  }

  .legal-copy > section {
    margin-top: 2.5rem;
    scroll-margin-top: 2rem;
  }

  .legal-copy h2 {
    color: var(--foreground);
    font-size: 1.35rem;
    font-weight: 700;
    letter-spacing: -0.02em;
    line-height: 1.3;
  }

  .legal-copy h3 {
    color: var(--foreground);
    font-size: 1rem;
    font-weight: 700;
    margin-top: 1.5rem;
  }

  .legal-copy p,
  .legal-copy ul,
  .legal-copy ol,
  .legal-copy dl,
  .legal-copy .legal-table-wrap {
    margin-top: 0.75rem;
  }

  .legal-copy ul,
  .legal-copy ol {
    padding-left: 1.4rem;
  }

  .legal-copy ul {
    list-style: disc;
  }

  .legal-copy ol {
    list-style: decimal;
  }

  .legal-copy li + li {
    margin-top: 0.45rem;
  }

  .legal-copy a {
    color: var(--accent);
    font-weight: 600;
    text-decoration: underline;
    text-decoration-thickness: 0.08em;
    text-underline-offset: 0.18em;
  }

  .legal-copy a:hover {
    opacity: 0.8;
  }

  .legal-copy dt {
    font-weight: 700;
  }

  .legal-copy dd + dt {
    margin-top: 0.7rem;
  }

  .legal-copy .legal-card {
    border: 1px solid var(--border);
    border-radius: 1rem;
    background: color-mix(in oklab, var(--muted) 35%, transparent);
    padding: 1rem 1.15rem;
  }

  .legal-copy .legal-warning {
    border: 1px solid color-mix(in oklab, var(--destructive) 45%, var(--border));
    border-radius: 1rem;
    background: color-mix(in oklab, var(--destructive) 7%, transparent);
    padding: 1rem 1.15rem;
  }

  .legal-copy .legal-warning strong {
    color: var(--destructive);
  }

  .legal-copy .legal-table-wrap {
    overflow-x: auto;
    border: 1px solid var(--border);
    border-radius: 1rem;
  }

  .legal-copy table {
    width: 100%;
    min-width: 42rem;
    border-collapse: collapse;
    font-size: 0.9rem;
  }

  .legal-copy th,
  .legal-copy td {
    padding: 0.8rem 0.9rem;
    text-align: left;
    vertical-align: top;
  }

  .legal-copy th {
    background: color-mix(in oklab, var(--muted) 60%, transparent);
    font-weight: 700;
  }

  .legal-copy tr + tr {
    border-top: 1px solid var(--border);
  }
</style>
