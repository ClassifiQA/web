---
import { AuthControl } from "@/components/custom/auth-control"
import { ThemeToggle } from "@/components/custom/theme"

const isProfilePage =
  Astro.url.pathname === "/perfil" || Astro.url.pathname.startsWith("/perfil/")
---

<header class="flex flex-row items-center justify-between gap-3 p-4 sm:p-6">
  {/* title */}
  <a
    href="/"
    aria-label="ClassifiQA — página inicial"
    class="shrink-0 text-xl tracking-wide sm:text-2xl">
    Classifi<span class="text-accent">QA</span>
  </a>

  {/* nav */}
  <div class="flex flex-row items-center gap-2">
    {/* menu */}
    <AuthControl client:load isProfilePage={isProfilePage} />

    {/* theme toggle */}
    <ThemeToggle client:load />
  </div>
</header>
