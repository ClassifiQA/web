---
import { Button } from "@/components/ui/button"
import { ThemeToggle } from "@/components/custom/theme"
import { User } from "lucide-react"
---

<header class="flex flex-row items-center justify-between p-6">
  {/* title */}
  <h1 class="text-2xl tracking-wide">
    Classifi<span class="text-accent">QA</span>
  </h1>

  {/* nav */}
  <div class="flex flex-row items-center gap-2">
    {/* menu */}
    <Button variant="outline" client:load>
      <User />
      A Minha Conta
    </Button>

    {/* theme toggle */}
    <ThemeToggle client:load />
  </div>
</header>
