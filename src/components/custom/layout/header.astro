---
import { AuthControl } from "@/components/custom/auth/auth-control"
import { ThemeToggle } from "./theme-toggle"
import { Button } from "@/components/ui/button"

const isProfilePage =
  Astro.url.pathname === "/perfil" || Astro.url.pathname.startsWith("/perfil/")
---

<header
  class="flex shrink-0 flex-row items-center justify-between gap-3 p-4 sm:p-6">
  {/* title */}
  <Button
    client:load
    href="/"
    aria-label="ClassifiQA - página inicial"
    variant="ghost"
    className="h-auto shrink-0 p-0 text-xl tracking-wide hover:bg-transparent sm:text-2xl">
    Classifi<span class="text-accent">QA</span>
  </Button>

  {/* nav */}
  <div class="flex flex-row items-center gap-2">
    <Button
      client:load
      href="/classificacoes"
      variant="ghost"
      className="hidden text-sm font-semibold text-muted-foreground sm:inline-flex">
      Classificações
    </Button>

    {/* menu */}
    <AuthControl client:load isProfilePage={isProfilePage} />

    {/* theme toggle */}
    <ThemeToggle client:load />
  </div>
</header>
