---
import { Button } from "@/components/ui/button"
import { Heart } from "lucide-react"

// copyright date & year
const date = new Date()
const year = date.getFullYear()

// footer links
const quickLinks: { text: string; href: string }[] = [
  {
    text: "Termos & Condições",
    href: "/legal/termos",
  },
  {
    text: "Política de Privacidade",
    href: "/legal/privacidade",
  },
]
---

<footer
  class="flex w-full shrink-0 flex-col items-center justify-between gap-1 px-2 py-1 sm:flex-row">
  {/* copyright */}
  <div class="flex flex-wrap items-center justify-center gap-x-2 text-xs">
    {/* copyright year */}
    <p class="items-center justify-center">
      &copy; {year}
      <span class="text-accent"> ClassifiQA</span>
    </p>

    {" | "}

    {/* author */}
    <p class="flex flex-row items-center gap-0.5">
      Feito com <Heart className="text-accent" fill="var(--accent)" size={14} /> por
      DanFQ
    </p>
  </div>

  {/* quick links */}
  <div class="flex flex-wrap items-center justify-center gap-1">
    {
      quickLinks.map((link) => (
        <Button
          client:load
          key={link.href}
          href={link.href}
          variant="link"
          className="text-xs">
          {link.text}
        </Button>
      ))
    }
  </div>
</footer>
