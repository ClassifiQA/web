---
import { MemberDirectory } from "@/components/custom/members/member-directory"
import { Button } from "@/components/ui/button"
import MainLayout from "@/layouts/main.astro"
import { createServerMembers } from "@/lib/hooks/backend/server/services/members"
import type { Member } from "@/lib/data/members"

let members: Member[] = []
let error: string | undefined

try {
  members = await createServerMembers().listActiveMembers()
  members.sort((left, right) =>
    left.name.localeCompare(right.name, "pt-PT", { sensitivity: "base" })
  )
} catch {
  Astro.response.status = 503
  error = "Não foi possível carregar a lista de pessoas neste momento."
}

Astro.response.headers.set(
  "Cache-Control",
  error
    ? "no-store"
    : "public, max-age=0, s-maxage=300, stale-while-revalidate=86400"
)
---

<MainLayout
  title="Classificações | ClassifiQA"
  description="Consulta e avalia os membros do Governo e da Assembleia da República."
  className="h-dvh overflow-hidden">
  <div class="min-h-0 flex-1 overflow-hidden">
    <div
      class="mx-auto flex h-full min-h-0 w-full max-w-7xl flex-col px-4 py-4 sm:px-6 sm:py-5">
      <header class="mb-4 max-w-3xl shrink-0">
        <p class="text-sm font-semibold text-accent">Classificações</p>
        <h1 class="mt-1 text-2xl font-bold tracking-tight sm:text-4xl">
          A quem queres dar nota?
        </h1>
        <p class="mt-2 text-sm text-muted-foreground sm:text-base">
          Pesquisa os membros em funções no Governo e na Assembleia da
          República.
        </p>
      </header>

      {
        error ? (
          <div
            role="alert"
            class="grid min-h-72 place-items-center rounded-3xl border border-dashed p-8 text-center">
            <div>
              <p class="text-muted-foreground">{error}</p>
              <Button
                client:load
                href="/classificacoes"
                variant="outline"
                className="mt-4">
                Recarregar página
              </Button>
            </div>
          </div>
        ) : (
          <MemberDirectory members={members} client:load />
        )
      }
    </div>
  </div>
</MainLayout>
