---
import MainLayout from "@/layouts/main.astro"
import { Button } from "@/components/ui/button"
import { HomeMembers } from "@/components/custom/members/home-members"
import { Image } from "astro:assets"
import ze_landing from "@/assets/img/ze_landing.svg"
import { createServerMembers } from "@/lib/hooks/backend/server/services/members"
import type { Member } from "@/lib/data/members"

let members: Member[] = []
let membersError: string | undefined

try {
  members = await createServerMembers().listFeaturedGovernmentMembers(3)
} catch {
  Astro.response.status = 503
  membersError = "Não foi possível carregar as pessoas disponíveis."
}

Astro.response.headers.set("Cache-Control", "private, no-store")
---

<MainLayout title="ClassifiQA" className="h-dvh">
  <div
    class="grid min-h-0 flex-1 grid-rows-[minmax(0,0.7fr)_minmax(0,1.3fr)] gap-3 overflow-hidden px-3 py-2 sm:px-6 lg:grid-cols-[minmax(20rem,0.85fr)_minmax(34rem,1.15fr)] lg:grid-rows-1 lg:gap-6 lg:py-4 xl:px-10 xl:py-6">
    <section class="flex min-h-0 items-center justify-center">
      {/* one-liner & hook */}
      <div class="flex flex-col items-center gap-2 text-center">
        <Image
          class="mb-2 h-[clamp(5rem,14vh,8rem)] w-auto lg:mb-4 lg:h-[clamp(8rem,23vh,12rem)]"
          src={ze_landing}
          height={200}
          alt="Zé Povinho"
        />
        <h1 class="text-xl sm:text-2xl">
          É a vez do <span class="text-accent">Zé</span> dar as notas
        </h1>
        <p class="max-w-xl text-sm sm:text-base">
          Durante séculos o Zé Povinho levou. Agora tem caneta <span
            class="text-red-600">vermelha</span
          > na mão.
        </p>

        {/* cta */}
        <div class="mt-2 items-center gap-2 sm:mt-4">
          <Button client:load href="/classificacoes">Dar a Minha Nota</Button>
        </div>
      </div>
    </section>

    <section
      id="classificacoes"
      aria-labelledby="classificacoes-title"
      class="flex h-fit min-h-0 flex-col self-center rounded-2xl border border-border bg-muted/30 p-3 lg:rounded-3xl lg:p-6">
      <HomeMembers members={members} error={membersError} client:idle />
    </section>
  </div>
</MainLayout>
